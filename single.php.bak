  <!-- ── SECTION 3: QUICK SPECS ── -->
  <div class="kvp-s-sec" id="kvp-specs">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
      <div style="width:32px; height:32px; background:#E8401C; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </div>
      <span style="font-size:11px; font-weight:600; color:#E8401C; text-transform:uppercase; letter-spacing:0.1em;">Quick Specs</span>
    </div>
    <h2 style="font-size:20px; font-weight:700; color:#1A1A1A; margin:0 0 20px 0; font-family:Lato,sans-serif;">Quick specs</h2>
    <table class="kvp-s-specs">
      <?php
      $spec_rows = array_filter( array_map( 'trim', explode( "\n", $kvp_specs ) ) );
      foreach ( $spec_rows as $row ) :
        $parts = explode( '|', $row );
        if ( count( $parts ) !== 2 ) continue;
      ?>
      <tr>
        <td><?php echo esc_html( trim( $parts[0] ) ); ?></td>
        <td><?php echo esc_html( trim( $parts[1] ) ); ?></td>
      </tr>
      <?php endforeach; ?>
    </table>
  </div>

  <!-- ── MID-ARTICLE CTA 1 ── -->
  <div class="kvp-s-cta1">
    <div class="kvp-s-cta1-left">
      <p class="kvp-s-cta1-eyebrow"><?php _e( 'Ready to buy?', 'kvp-theme' ); ?></p>
      <p class="kvp-s-cta1-title"><?php the_title(); ?></p>
      <?php if ( $kvp_rating ) : ?>
      <p class="kvp-s-cta1-rating">
        <span class="kvp-s-cta1-stars" aria-hidden="true">★</span>
        <span class="kvp-s-cta1-rating-num"><?php echo esc_html( $kvp_rating ); ?></span>
        <?php if ( $kvp_review_count ) : ?>
        <span class="kvp-s-cta1-rating-count">&middot; <?php echo esc_html( $kvp_review_count ); ?>+ <?php _e( 'reviews on Amazon', 'kvp-theme' ); ?></span>
        <?php endif; ?>
      </p>
      <?php endif; ?>
    </div>
    <div class="kvp-s-cta1-right">
      <span class="kvp-s-cta1-price"><?php echo esc_html( $kvp_price_clean ); ?></span>
      <span class="kvp-s-cta1-price-note"><?php _e( 'at time of writing', 'kvp-theme' ); ?></span>
      <a href="<?php echo esc_url( $kvp_amazon_url ); ?>" rel="sponsored nofollow" target="_blank" class="kvp-s-cta1-btn">
        <?php _e( 'Check price on Amazon →', 'kvp-theme' ); ?>
      </a>
    </div>
  </div>

  <!-- ── SECTION 4: THE FULL REVIEW ── -->
  <div class="kvp-s-sec" id="kvp-review">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
