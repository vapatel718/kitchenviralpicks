get_header();
?>

<main class="kvp-s-main">
<div class="kvp-s-wrap">

<?php while ( have_posts() ) : the_post();

    $kvp_rating       = get_post_meta( get_the_ID(), 'kvp_rating',        true );
    $kvp_price        = get_post_meta( get_the_ID(), 'kvp_price',         true );
    $kvp_best_for     = get_post_meta( get_the_ID(), 'kvp_best_for',      true );
    $kvp_skip_if      = get_post_meta( get_the_ID(), 'kvp_skip_if',       true );
    $kvp_verdict_line = get_post_meta( get_the_ID(), 'kvp_verdict_line',  true );
    $kvp_amazon_url   = get_post_meta( get_the_ID(), 'kvp_amazon_url',    true );
    $kvp_pros         = get_post_meta( get_the_ID(), 'kvp_pros',          true );
    $kvp_cons         = get_post_meta( get_the_ID(), 'kvp_cons',          true );
    $kvp_specs        = get_post_meta( get_the_ID(), 'kvp_specs',         true );
    $kvp_final        = get_post_meta( get_the_ID(), 'kvp_final_verdict', true );
    $kvp_review_count = get_post_meta( get_the_ID(), 'kvp_review_count',  true );
    $kvp_price_clean  = str_replace( ' at time of writing', '', $kvp_price );
    $kvp_short_name   = get_post_meta( get_the_ID(), 'kvp_short_name', true );
    $cta_title        = $kvp_short_name ? $kvp_short_name : wp_trim_words( get_the_title(), 6, '...' );

    $pros_items = array_filter( array_map( 'trim', explode( "\n", $kvp_pros ) ) );
    $cons_items = array_filter( array_map( 'trim', explode( "\n", $kvp_cons ) ) );

    $cats = get_the_category();
?>

  <!-- ── 1. BREADCRUMB ── -->
  <p class="kvp-s-breadcrumb">
    <a href="<?php echo esc_url( home_url( '/' ) ); ?>"><?php _e( 'Home', 'kvp-theme' ); ?></a>
    <?php if ( $cats ) : ?>
      › <a href="<?php echo esc_url( get_category_link( $cats[0]->term_id ) ); ?>" class="kvp-s-bc-link"><?php echo esc_html( $cats[0]->name ); ?></a>
    <?php endif; ?>
    › <span class="kvp-s-bc-current"><?php echo esc_html( get_the_title() ); ?></span>
  </p>

  <!-- ── 2. CATEGORY LABEL ── -->
  <?php if ( $cats ) : ?>
  <span class="kvp-s-cat-label"><?php echo esc_html( $cats[0]->name ); ?></span>
  <?php endif; ?>

  <!-- ── 3. ARTICLE TITLE ── -->
  <h1 class="kvp-s-title"><?php the_title(); ?></h1>

  <!-- ── 4. BYLINE ── -->
  <p class="kvp-s-byline">
    <?php _e( 'By Deborah &mdash; Kitchen Product Curator', 'kvp-theme' ); ?>
    &nbsp;&middot;&nbsp;
    <?php echo esc_html( get_the_date() ); ?>
    &nbsp;&middot;&nbsp;
    <?php echo esc_html( $kvp_review_count ); ?> <?php _e( 'verified reviews analyzed', 'kvp-theme' ); ?>
  </p>

  <!-- ── 5. TABLE OF CONTENTS ── -->
