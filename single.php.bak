      <div class="kvp-s-who-card kvp-s-who-card--skip">
        <p class="kvp-s-who-card-title kvp-s-who-card-title--skip"><?php _e( 'Skip it if', 'kvp-theme' ); ?></p>
        <?php foreach ( $cons_items as $item ) : ?>
        <div class="kvp-s-who-item">
          <span class="kvp-s-arrow kvp-s-arrow--red">→</span>
          <?php echo esc_html( $item ); ?>
