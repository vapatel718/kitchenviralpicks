        <p class="kvp-s-meta-label"><?php _e( 'RESEARCH RATING', 'kvp-theme' ); ?></p>
        <p class="kvp-s-meta-value">★★★★★ <?php echo esc_html( $kvp_rating ); ?></p>
      </div>
      <div>
        <p class="kvp-s-meta-label"><?php _e( 'PRICE', 'kvp-theme' ); ?></p>
        <p class="kvp-s-meta-value">
          <span class="kvp-price-wrap">
            <span class="kvp-price-amount"><?php echo esc_html( $kvp_price_clean ); ?></span>
