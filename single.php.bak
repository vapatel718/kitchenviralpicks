    <h2 style="font-size:20px; font-weight:700; color:#1A1A1A; margin:0 0 20px 0; font-family:Lato,sans-serif;">What buyers complain about</h2>
    <div class="kvp-s-body kvp-article-body">
      <?php the_content(); ?>
    </div>
  </div>

  <!-- ── MID-ARTICLE CTA 2 ── -->
  <div class="kvp-s-cta2">
    <div class="kvp-s-cta2-left">
      <p class="kvp-s-cta2-eyebrow"><?php _e( "Deborah's verdict", 'kvp-theme' ); ?></p>
