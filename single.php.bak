  <!-- ── 7. QUICK VERDICT BOX ── -->
  <div class="kvp-s-verdict" id="kvp-verdict">

    <?php if ( has_post_thumbnail() ) : ?>
    <div style="text-align: center; margin-bottom: 20px;">
      <?php the_post_thumbnail( 'medium', array(
        'style' => 'max-width: 320px; width: 100%; border-radius: 10px; display: block; margin: 0 auto;',
        'alt'   => get_the_title()
      ) ); ?>
