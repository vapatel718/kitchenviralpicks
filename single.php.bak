    <a class="kvp-s-toc-pill" href="#kvp-specs"><?php    _e( 'Specs',          'kvp-theme' ); ?></a>
    <a class="kvp-s-toc-pill" href="#kvp-review"><?php   _e( 'Full review',    'kvp-theme' ); ?></a>
    <a class="kvp-s-toc-pill" href="#kvp-final"><?php    _e( 'Final verdict',  'kvp-theme' ); ?></a>
  </div>

  <!-- ── 6. FTC DISCLOSURE ── -->
  <div class="kvp-s-disclosure">
    <?php _e( 'Disclosure: As an Amazon Associate, I earn from qualifying purchases at no extra cost to you. Recommendations are based on research and verified customer reviews.', 'kvp-theme' ); ?>
