        <?php endforeach; ?>
      </div>

    </div>
  </div>

  <!-- ── SECTION 2: PROS & CONS ── -->
  <div class="kvp-s-sec" id="kvp-proscons">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
